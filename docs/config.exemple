# Fichier de configuration de nhmapedit, à copier dans
#   ~/.config/nhmapedit/config
# (ou dans le fichier désigné par la variable NHMAPEDIT_CONFIG).
# Toutes les clés sont facultatives ; retirez le « # » pour les activer.

[jeu]
# Répertoire de données du jeu, pour la touche « t » (tester)
#repertoire = ~/nh/install/games/lib/nethackdir
# Fichier dungeon.lua modifié par la touche « D »
#dungeon = ~/JEUX/NETHACK/NetHack-5.0.0/dat/dungeon.lua
# Langue du jeu, pour montrer les noms vus en jeu (« chien errant » pour
# jackal) : fr@cyber (thème cyberpunk), fr, ou en (noms du script seuls).
# Par défaut : l'option language du ~/.nethackrc, sinon fr@cyber.
#langue = fr@cyber
# Symboles et couleurs du rendu « comme dans le jeu » (touche J) : auto
# (palette néon doc/cyberpunk.nethackrc des sources si le jeu est en
# fr@cyber, puis les options glyph de votre ~/.nethackrc), aucune, ou le
# chemin d'un .nethackrc
#palette = auto
# Essai (t) : le joueur arrive sur l'escalier montant (oui, défaut) ou
# à une place tirée au hasard par #wizloaddes (non)
#arrivee = oui
# Serveur NetHack dans un conteneur LXD (install-serveur-nethack.sh) pour
# la touche « t », sur ce poste ou distant. Adresse IP du serveur
# proposée (localhost : ce poste) et compte SSH sur un serveur distant
# (clé SSH, membre du groupe lxd)
#serveur_adresse = 192.168.1.20
#serveur_compte = util01
# Nom du conteneur (par défaut, celui qui tourne sur le serveur), ou
# « aucun » pour ne jamais proposer de serveur
#serveur = nethack
# Dossier du jeu dans le conteneur (chroot de dgamelaunch)
#serveur_dossier = /opt/nethack/chroot/home/util01/nethack500
# Commande de connexion affichée (par défaut : l'adresse du proxy LXD
# ssh-nethack du conteneur)
#serveur_ssh = ssh -p 2222 nethack@192.168.1.10

[editeur]
# Taille d'une nouvelle carte
#taille = 75x19
# Règles de coordonnées et entités affichées au démarrage (oui / non)
#regles = oui
#entites = oui
# Symboles Unicode des murs : auto, oui ou non
#unicode = auto
# Sauvegarde de secours toutes les N secondes (0 : désactivée)
#sauvegarde = 60
# Langue de l'interface : auto (selon LANG), fr ou en
#langue = auto
# Thème des menus, comme le lanceur NetHack : auto (cyber pour la
# version cyberpunk du jeu, sinon classique), classique, cyber ou sobre
#theme = auto
# Fenêtre d'accueil au démarrage (faire une carte, placer le joueur) ;
# F1 la rouvre, d la désactive (fichier sans-accueil)
#accueil = oui

[couleurs]
# Couleur d'un terrain : black, red, green, brown, blue, magenta, cyan,
# gray, orange, bright_green, yellow, bright_blue, bright_magenta,
# bright_cyan, white. La roche (espace) s'écrit « roche », le couloir
# (#) « couloir ».
#} = bright_blue
#T = green

[touches]
# Remplacement de touches : touche tapée = touche de l'éditeur.
# Noms possibles : espace, entree, tab, echap, ctrl-x.
#z = u
#ctrl-z = u
